/* pages/cartInfo/index.wxss */
.cart_content {
  padding-bottom: 90rpx;
  background-color: #f5f5f5;
}

.cart_content .cart_title {
  padding: 20rpx;
  font-size: 36rpx;
  color: var(--themeColor);
  border-top: 1rpx solid rgba(37, 99, 235, 0.3);
  border-bottom: 1rpx solid rgba(37, 99, 235, 0.3);
  background: linear-gradient(135deg, #E3F2FD, #FFFFFF);
}

.cart_content .cart_main {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cart_content .cart_main image {
  width: 100%;
  border-radius: 20rpx;
}

.cart_content .cart_main .cart_item {
  display: flex;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.cart_content .cart_main .cart_item .cart_img_wrap {
  flex:2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart_content .cart_main .cart_item .cart_img_wrap image{
  width: 80%;
  border-radius: 12rpx;
}

.cart_content .cart_main .cart_item .cart_info_wrap {
  flex: 4;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.cart_content .cart_main .cart_item .cart_info_wrap .goods_name {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #666;
}

.cart_content .cart_main .cart_item .cart_info_wrap .goods_price_wrap {
  display: flex;
  justify-content: space-between;
}

.cart_content .cart_main .cart_item .cart_info_wrap .goods_price_wrap .goods_price {
  color: var(--dangerColor);
  font-size: 34rpx;
}

.cart_content .cart_main .cart_item .cart_info_wrap .goods_price_wrap .cart_num_tool {
  display: flex;
}

.cart_content .cart_main .cart_item .cart_info_wrap .goods_price_wrap .cart_num_tool .num_edit {
  display: flex;
  width: 55rpx;
  height: 55rpx;
  justify-content: center;
  align-items: center;
  border: 1rpx solid var(--borderColor);
  border-radius: 12rpx;
}

.cart_content .cart_main .cart_item .cart_info_wrap .goods_price_wrap .cart_num_tool .goods_num {
  display: flex;
  width: 55rpx;
  height: 55rpx;
  justify-content: center;
  align-items: center;
}


.footer_tool {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 90rpx;
  background-color: #ffffff;
  display: flex;
  border: 1rpx solid var(--borderColor);
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.footer_tool .total_price_wrap {
  flex: 5;
  padding-left: 40rpx;
  text-align: left;
}

.footer_tool .total_price_wrap .total_price_text {
  color: var(--dangerColor);
  font-size: 34rpx;
  font-weight: 600;
}

.footer_tool .order_pay_wrap {
  flex: 3;
  background: linear-gradient(135deg, #1A73E8, #2563EB);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 999rpx;
}