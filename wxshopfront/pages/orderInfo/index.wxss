/* pages/orderInfo/index.wxss */
.nx_line {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.nx_line_list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nx_line_list image {
  width: 100%;
  border-radius: 20rpx;
}

.nx_line_item {
  width: 100%;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.nx_line_left {
  flex: 2;
  display: flex;
  align-items: center;
}

.nx_line_left image {
  width: 100%;
  height: 140rpx;
  border-radius: 12rpx;
}

.nx_line_mid {
  flex: 5;
  padding: 0 40rpx;
}

.nx_line_right {
  flex: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #999;
}

.btn {
  font-size: 28rpx;
  border: 1px solid #ccc;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background-color: #eee;
  margin: 0 10rpx;
}