<!--pages/orderInfo/index.wxml-->
<view class="nx_line">
  <view class="nx_line_list">
    <block wx:if="{{dataList.length==0}}">
      <view class="empty-state">
        <image class="empty-state__img" mode="widthFix" src="../../imgs/cartNone.gif"></image>
        <text class="empty-state__text">暂无商品</text>
      </view>
    </block>
    <block wx:else>
      <view class="nx_line_item" wx:for="{{dataList}}" wx:for-item="item">
        <navigator style="display: flex;" url="/pages/orderDetail/index?id={{item.id}}&&state={{item.state}}">
          <view class="nx_line_left">
            <image mode="scaleToFill" src="{{item.url}}"></image>
          </view>
          <view class="nx_line_mid">
            <view style="color: black;padding: 15rpx 0;">订单编号: {{item.orderid}}</view>
            <view style="padding-top:20rpx;">订单状态: {{item.state}}</view>
          </view>
          <view class="nx_line_right">
            <text style="color: red;">¥{{item.totalprice}}</text>
            <text style="padding-top: 10rpx;">共{{item.count}}件</text>
          </view>
        </navigator>

        <view style="text-align: right;padding: 20rpx;display: flex;flex-wrap: wrap;justify-content: flex-end;gap: 10rpx;">
          <text wx:if="{{item.state === '待付款'}}" style="background-color: var(--themeColor);color: white;" class="btn" bindtap="payGoods" data-id="{{item.id}}" data-state="待发货">付款</text>
          <text wx:if="{{item.state === '待付款'}}" class="btn" bindtap="payGoods" data-id="{{item.id}}" data-state="已取消">取消</text>
          <text wx:if="{{item.state === '待收货'}}" style="background-color: var(--themeColor);color: white;" class="btn" bindtap="payGoods" data-id="{{item.id}}" data-state="完成">确认收货</text>
          <text wx:if="{{item.state === '待发货'}}" style="background-color: var(--themeColor);color: white;" class="btn" bindtap="finishOrder" data-id="{{item.id}}">完成订单</text>
          <text wx:if="{{item.state === '完成'}}" style="background-color: var(--themeColor);color: white;" class="btn" bindtap="payGoods" data-id="{{item.id}}" data-state="申请退货中">退货</text>
          <text wx:if="{{item.state === '已退货' || item.state === '完成'|| item.state === '已取消'}}" class="btn" bindtap="deleteOrder" data-id="{{item.id}}">删除订单</text>
        </view>

      </view>
    </block>
  </view>
</view>