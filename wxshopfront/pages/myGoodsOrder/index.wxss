.nx_line {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.nx_line_list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nx_line_list image {
  width: 100%;
  border-radius: 20rpx;
}

.nx_line_item {
  width: 100%;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.nx_line_left image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.nx_line_mid {
  flex: 1;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #666;
}

.nx_line_right {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  padding-right: 20rpx;
  font-size: 24rpx;
}

.btn {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-left: 16rpx;
  border-radius: 40rpx;
  border: 1rpx solid #ddd;
  font-size: 24rpx;
  color: #333;
}

