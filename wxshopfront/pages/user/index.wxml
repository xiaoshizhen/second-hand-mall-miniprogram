<!--pages/user/index.wxml-->
<view class="user_info_wrap">
  <view wx:if="{{isLogin === 1}}" class="user_img_wrap">
    <image class="user_bg" src="../../imgs/head.jpg"></image>
    <view class="user_info">
      <image class="user_icon" src="{{userInfo.code}}"></image>
      <view class="user_name">{{userInfo.name}}</view>
    </view>
  </view>
  <view wx:else class="user_btn">
    <button open-type="getUserInfo" bindgetuserinfo="getUserInfo">登录</button>
  </view>
</view>

<view class="user_content">
  <view class="user_main">
    <view class="orders_wrap">
      <view class="orders_title">
        我的订单
      </view>
      <view class="orders_content">
        <view class="navigator" bindtap="navigateToOrder" data-state="all">
          <view class="order_name">全部订单</view>
        </view>
        <view class="navigator" bindtap="navigateToOrder" data-state="待付款">
          <view class="order_name">待付款</view>
        </view>
        <view class="navigator" bindtap="navigateToOrder" data-state="待收货">
          <view class="order_name">待收货</view>
        </view>
        <view class="navigator" bindtap="navigateToOrder" data-state="refund">
          <view class="order_name">退款/退货</view>
        </view>
      </view>
    </view>

    <!-- 我的评价，单独区域 -->
    <view class="orders_wrap">
      <view class="orders_title">
        我的评价
      </view>
      <view class="orders_content">
        <view class="navigator" bindtap="goMyComments">
          <view class="order_name">查看我的评价</view>
        </view>
      </view>
    </view>

    <!-- 我的商品，单独区域 -->
    <view class="orders_wrap">
      <view class="orders_title">
        我的商品
      </view>
      <view class="orders_content">
        <view class="navigator" bindtap="goMyGoods">
          <view class="order_name">发布 / 管理商品</view>
        </view>
        <view class="navigator" bindtap="goMyGoodsOrder">
          <view class="order_name">我的商品订单</view>
        </view>
      </view>
    </view>

    <!-- 应用信息相关 -->
    <view class="app_info_wrap">
      <view class="app_info_item app_info_contact">
        <text>联系客服</text>
        <text>888-8888-8888</text>
      </view>
      <view class="app_info_item">
        关于我们
      </view>
      <view class="app_info_item" bindtap="recharge">
        充值（当前余额：￥{{price}}）
      </view>
      <view class="app_info_item" bindtap="goEditProfile">
        修改个人资料
      </view>
    </view>
  </view>
</view>