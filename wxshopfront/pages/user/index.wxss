/* pages/user/index.wxss */
page {
  background-color: #F3F6FB;
}

.user_info_wrap{
  height: 45vh;
  overflow: hidden;
  background: linear-gradient(145deg, #1A73E8, #2563EB);
  position: relative;
}

.user_info_wrap .user_img_wrap {
  position: relative;
}

.user_info_wrap .user_img_wrap .user_bg{
  height: 50vh;
  filter: blur(10rpx);
  border-radius: 0;
}

.user_info_wrap .user_img_wrap .user_info {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 20%;
  text-align: center;
}

.user_info_wrap .user_img_wrap .user_info .user_icon{
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.25);
}

.user_info_wrap .user_img_wrap .user_info .user_name{
  color: #fff;
  margin-top: 40%;
  font-size: 32rpx;
  font-weight: 600;
}

.user_info_wrap .user_btn{
  position: relative;
  left: 50%;
  transform: translateX(-50%);
  top: 40%;
  border: none;
  background: linear-gradient(135deg, #FFFFFF, #E3F2FD);
  color: #1A73E8;
  font-size: 38rpx;
  padding: 24rpx 60rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.25);
}

.user_content {
  position: relative;
}

.user_content .user_main {
  padding-bottom: 100rpx;
  color: var(--textSubColor);
  position: absolute;
  width: 90%;
  left: 50%;
  transform: translateX(-50%);
  top: -40rpx;
}

.user_content .user_main .orders_wrap {
  background-color: #ffffff;
  margin-top: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.user_content .user_main .orders_wrap .orders_title{
  padding: 20rpx;
  border-bottom: 1rpx solid var(--borderColor);
}

.user_content .user_main .orders_wrap .orders_content{
  display: flex;
}

.user_content .user_main .orders_wrap .orders_content .navigator{
  padding: 15rpx 0;
  flex: 1;
  text-align: center;
}

.user_content .user_main .app_info_wrap {
  margin-top: 30rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.user_content .user_main .app_info_wrap .app_info_item {
  padding: 20rpx;
  border-bottom: 1rpx solid var(--borderColor);
}

.user_content .user_main .app_info_wrap .app_info_contact {
  display: flex;
  justify-content: space-between;
}