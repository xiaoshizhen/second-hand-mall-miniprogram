/* pages/myGoodsList/index.wxss */
.nx_line {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.nx_line_list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nx_line_list image {
  width: 100%;
  border-radius: 20rpx;
}

.nx_line_item {
  width: 100%;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.goods-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.goods-image {
  width: 180rpx;
  height: 180rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
}

.goods-image image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.goods-info {
  flex: 1;
}

.goods-name {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.goods-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
}

.price {
  color: #e64340;
  margin-right: 30rpx;
}

.sales {
  color: #999999;
}

.stock {
  color: #999999;
  margin-left: 30rpx;
}

.goods-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.btn {
  font-size: 26rpx;
  border: 1px solid #ccc;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  margin-bottom: 10rpx;
}

.edit-btn {
  background-color: #ffffff;
}

.delete-btn {
  background-color: #eee;
}

.add-btn-wrap {
  margin-top: 30rpx;
}

.add-btn {
  width: 100%;
  border-radius: 999rpx;
}

